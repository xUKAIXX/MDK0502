@model ProfileViewModel
@{
    ViewData["Title"] = "Профиль";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body p-4">
                <h1 class="h4 mb-3">Профиль</h1>
                <dl class="row">
                    <dt class="col-sm-4">ФИО</dt>
                    <dd class="col-sm-8">@Model.FullName</dd>
                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>
                    <dt class="col-sm-4">Телефон</dt>
                    <dd class="col-sm-8">@(Model.Phone ?? "не указан")</dd>
                    <dt class="col-sm-4">Дата регистрации</dt>
                    <dd class="col-sm-8">@Model.RegisteredAt.ToString("dd.MM.yyyy")</dd>
                    <dt class="col-sm-4">Роли</dt>
                    <dd class="col-sm-8">@string.Join(", ", Model.Roles)</dd>
                </dl>
                <a asp-controller="Properties" asp-action="Index" class="btn btn-outline-primary">К списку объектов</a>
            </div>
        </div>
    </div>
</div>
