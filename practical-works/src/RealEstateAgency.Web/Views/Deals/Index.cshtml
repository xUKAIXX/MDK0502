@model DealIndexViewModel
@{
    ViewData["Title"] = "Сделки";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Сделки</h1>
        <p class="text-muted mb-0">Всего сделок: <strong>@Model.Items.Count</strong></p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Новая сделка
    </a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>№</th>
                    <th>Объект</th>
                    <th>Клиент</th>
                    <th>Тип</th>
                    <th>Сумма</th>
                    <th>Статус</th>
                    <th>Создана</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var deal in Model.Items)
                {
                    <tr>
                        <td>#@deal.Id</td>
                        <td>@deal.PropertyTitle</td>
                        <td>
                            @deal.ClientName
                            <div class="text-muted small">@deal.ClientPhone</div>
                        </td>
                        <td>@deal.Type</td>
                        <td class="fw-semibold">@deal.Amount.ToString("N0") ₽</td>
                        <td>
                            <span class="badge @(deal.Status == "Завершена" ? "bg-success" : deal.Status == "Отменена" ? "bg-secondary" : deal.Status == "В работе" ? "bg-info" : "bg-warning text-dark")">
                                @deal.Status
                            </span>
                        </td>
                        <td>@deal.CreatedAt.ToString("dd.MM.yyyy")</td>
                        <td class="text-end text-nowrap">
                            @if (User.IsInRole("Admin") || User.IsInRole("Agent"))
                            {
                                @if (deal.Status == "Новая")
                                {
                                    <form asp-action="Start" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@deal.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-info">В работу</button>
                                    </form>
                                }
                                @if (deal.Status is "Новая" or "В работе")
                                {
                                    <form asp-action="Complete" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@deal.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-success">Завершить</button>
                                    </form>
                                    <form asp-action="Cancel" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@deal.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Отменить</button>
                                    </form>
                                }
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">Сделок пока нет.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
