@if (User.Identity?.IsAuthenticated == true)
{
    <span class="navbar-text text-white me-3">
        <i class="bi bi-person-circle me-1"></i> @User.Identity.Name
    </span>
    <a class="btn btn-outline-light btn-sm me-2" asp-controller="Account" asp-action="Profile">Профиль</a>
    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
        <button type="submit" class="btn btn-warning btn-sm">Выйти</button>
    </form>
}
else
{
    <a class="btn btn-outline-light btn-sm me-2" asp-controller="Account" asp-action="Login">Войти</a>
    <a class="btn btn-warning btn-sm" asp-controller="Account" asp-action="Register">Регистрация</a>
}
