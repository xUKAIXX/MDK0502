@model PropertyFormViewModel
@{
    ViewData["Title"] = "Редактировать объект";
}

<h1 class="h3 mb-4">Редактировать объект</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />
            <partial name="_PropertyFields" model="Model" />
            <button type="submit" class="btn btn-primary">Сохранить</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Отмена</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
