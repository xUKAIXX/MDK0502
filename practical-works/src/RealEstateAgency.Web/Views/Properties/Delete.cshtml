@model PropertyDto
@{
    ViewData["Title"] = "Удалить объект";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-body p-4">
                <h1 class="h4 text-danger mb-3">Удалить объект?</h1>
                <p>Вы действительно хотите удалить объект «@Model.Title»? Это действие нельзя отменить.</p>
                <dl class="row">
                    <dt class="col-sm-4">Адрес</dt>
                    <dd class="col-sm-8">@Model.Address</dd>
                    <dt class="col-sm-4">Цена</dt>
                    <dd class="col-sm-8">@Model.Price.ToString("N0") ₽</dd>
                    <dt class="col-sm-4">Статус</dt>
                    <dd class="col-sm-8">@Model.Status</dd>
                </dl>
                <form asp-action="Delete" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-danger">Удалить</button>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Отмена</a>
                </form>
            </div>
        </div>
    </div>
</div>
