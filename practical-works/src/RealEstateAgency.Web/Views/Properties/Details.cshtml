@model PropertyDto
@{
    ViewData["Title"] = Model.Title;
}

<div class="row">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="property-thumb">
                <i class="bi bi-building"></i>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                    <div>
                        <h1 class="h4 mb-1">@Model.Title</h1>
                        <p class="text-muted mb-0"><i class="bi bi-geo-alt"></i> @Model.Address</p>
                    </div>
                    <span class="badge @(Model.Status == "Продано" || Model.Status == "Сдано" ? "bg-secondary" : "bg-success") fs-6">@Model.Status</span>
                </div>

                <div class="row mt-4">
                    <div class="col-6 col-md-3 mb-3">
                        <div class="text-muted small">Цена</div>
                        <div class="fs-5 fw-bold text-primary">@Model.Price.ToString("N0") ₽</div>
                    </div>
                    <div class="col-6 col-md-3 mb-3">
                        <div class="text-muted small">Площадь</div>
                        <div class="fs-5">@Model.Area м²</div>
                    </div>
                    <div class="col-6 col-md-3 mb-3">
                        <div class="text-muted small">Комнат</div>
                        <div class="fs-5">@Model.Rooms</div>
                    </div>
                    <div class="col-6 col-md-3 mb-3">
                        <div class="text-muted small">Этаж</div>
                        <div class="fs-5">@Model.Floor из @Model.TotalFloors</div>
                    </div>
                </div>

                <hr />

                <dl class="row">
                    <dt class="col-sm-4">Тип объекта</dt>
                    <dd class="col-sm-8">@Model.PropertyType</dd>
                    <dt class="col-sm-4">Район</dt>
                    <dd class="col-sm-8">@Model.District</dd>
                    <dt class="col-sm-4">Год постройки</dt>
                    <dd class="col-sm-8">@Model.YearBuilt</dd>
                    <dt class="col-sm-4">Агент</dt>
                    <dd class="col-sm-8">@Model.Agent</dd>
                    @if (!string.IsNullOrWhiteSpace(Model.OwnerName))
                    {
                        <dt class="col-sm-4">Владелец</dt>
                        <dd class="col-sm-8">@Model.OwnerName</dd>
                    }
                    <dt class="col-sm-4">Добавлен</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToString("dd.MM.yyyy")</dd>
                </dl>

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p class="mt-3">@Model.Description</p>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-body">
                <h2 class="h6">Действия</h2>
                <div class="d-grid gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Назад к списку</a>
                    @if (User.IsInRole("Admin") || User.IsInRole("Agent"))
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Редактировать</a>
                        @if (Model.Status == "Продаётся")
                        {
                            <form asp-action="ChangeStatus" method="post">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="status" value="3" />
                                <button type="submit" class="btn btn-success w-100">Отметить как продано</button>
                            </form>
                            <form asp-action="ChangeStatus" method="post">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="status" value="2" />
                                <button type="submit" class="btn btn-outline-success w-100">Перевести в аренду</button>
                            </form>
                        }
                        else if (Model.Status == "Сдаётся")
                        {
                            <form asp-action="ChangeStatus" method="post">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="status" value="4" />
                                <button type="submit" class="btn btn-success w-100">Отметить как сдано</button>
                            </form>
                            <form asp-action="ChangeStatus" method="post">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="status" value="1" />
                                <button type="submit" class="btn btn-outline-success w-100">Перевести в продажу</button>
                            </form>
                        }
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Удалить</a>
                    }
                </div>
            </div>
        </div>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="card">
                <div class="card-body">
                    <h2 class="h6">Оставить заявку</h2>
                    <p class="text-muted small">Авторизуйтесь как клиент, чтобы создать сделку по этому объекту.</p>
                    <a asp-controller="Deals" asp-action="Create" class="btn btn-primary w-100">Создать сделку</a>
                </div>
            </div>
        }
    </div>
</div>
