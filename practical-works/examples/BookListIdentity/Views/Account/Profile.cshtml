@model BookList.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Профиль";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2>Профиль</h2>

        <dl class="row">
            <dt class="col-sm-4">Имя</dt>
            <dd class="col-sm-8">@Model.FullName</dd>
            <dt class="col-sm-4">Электронная почта</dt>
            <dd class="col-sm-8">@Model.Email</dd>
            <dt class="col-sm-4">Дата регистрации</dt>
            <dd class="col-sm-8">@Model.RegisteredAt.ToString("dd.MM.yyyy")</dd>
            <dt class="col-sm-4">Роль</dt>
            <dd class="col-sm-8">@Model.Role</dd>
        </dl>

        <a asp-controller="Books" asp-action="Index" class="btn btn-secondary">К списку книг</a>
    </div>
</div>
